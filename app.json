{
  "expo": {
    "name": "uniShopify",
    "slug": "uniShopify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/PlayfairDisplaySC-Black.ttf",
          "./assets/fonts/PlayfairDisplaySC-BlackItalic.ttf",
          "./assets/fonts/PlayfairDisplaySC-Bold.ttf",
       "./assets/fonts/PlayfairDisplaySC-BoldItalic.ttf",
      "./assets/fonts/PlayfairDisplaySC-Italic.ttf",
      "./assets/fonts/PlayfairDisplaySC-Regular.ttf",
      "./assets/fonts/Unna-Bold.ttf",
      "./assets/fonts/Unna-BoldItalic.ttf",
      "./assets/fonts/Unna-Regular.ttf"
      ]
        }
      ]
    ]
  }
}
